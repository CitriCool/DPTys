# Copia este archivo como .env para ejecutar sin Docker.
# Todas las variables usan el prefijo DPTYS_ (ver config/*.php).

DPTYS_APP_NAME=DPTyS
DPTYS_APP_ENV=local
DPTYS_APP_KEY=
DPTYS_APP_DEBUG=true
DPTYS_APP_URL=http://localhost:8081

DPTYS_LOG_CHANNEL=stack
DPTYS_LOG_LEVEL=debug

# Base de datos SQL Server (con Docker usa los valores de docker-compose.yml)
DPTYS_DB_CONNECTION=sqlsrv
DPTYS_DB_HOST=127.0.0.1
DPTYS_DB_PORT=1434
DPTYS_DB_DATABASE=DPTYS
DPTYS_DB_USERNAME=sa
DPTYS_DB_PASSWORD=Dptys_Dev_2026!
DPTYS_DB_ENCRYPT=yes
DPTYS_DB_TRUST_SERVER_CERTIFICATE=true

DPTYS_CACHE_DRIVER=file
DPTYS_SESSION_DRIVER=file
DPTYS_SESSION_LIFETIME=120
DPTYS_QUEUE_CONNECTION=sync
DPTYS_FILESYSTEM_DISK=local

# Correos de alertas: "log" los escribe en el log (sin enviar). Configurar SMTP en producción.
DPTYS_MAIL_MAILER=log
DPTYS_MAIL_FROM_ADDRESS=no-responder@dptys.local
DPTYS_MAIL_FROM_NAME=DPTyS
DPTYS_MAIL_LOG_CHANNEL=correos

# Cargar los datos de prueba ficticios al ejecutar db:seed
DPTYS_SEED_DEMO=true
